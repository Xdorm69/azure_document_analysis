+    <Card>
+      <CardHeader>
+        <CardTitle>Risk Breakdown by Category</CardTitle>
+        <CardDescription>
+          Legal, financial, compliance, contractual, operational
+        </CardDescription>
+      </CardHeader>
+      <CardContent>
+        <p className="py-4 text-sm text-muted-foreground">
