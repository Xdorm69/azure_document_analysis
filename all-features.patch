@@ -0,0 +1,52 @@
+import { cn } from "cn";
+import type { LucideIcon } from "lucide-react";
+
+import { Card, CardContent } from "@/components/ui/card";
+import { useCountUp } from "@/lib/hooks/use-count-up";
+
+function AnimatedValue({ value }: { value: string | number }) {
+  const numeric = typeof value === "number" ? value : null;
+  const animated = useCountUp(numeric ?? 0);
+  return <>{numeric === null ? value : animated}</>;
+}
+
+export function StatCard({
+  label,
+  value,
+  icon: Icon,
+  hint,
+  className,
+}: {
+  label: string;
+  value: string | number;
+  icon: LucideIcon;
+  hint?: string;
+  className?: string;
+}) {
+  return (
+    <Card
+      className={cn(
+        "transition-all duration-200 hover:shadow-md hover:ring-foreground/15",
+        className
+      )}
+    >
+      <CardContent className="flex flex-row items-start justify-between gap-3">
+        <div className="min-w-0">
+          <p className="text-sm text-muted-foreground">{label}</p>
+          <p className="mt-1.5 text-3xl font-semibold tabular-nums tracking-tight">
+            <AnimatedValue value={value} />
+          </p>
+          {hint && (
+            <p className="mt-1 truncate text-xs text-muted-foreground">
+              {hint}
+            </p>
+          )}
+        </div>
+
+        <div className="flex size-9 shrink-0 items-center justify-center rounded-lg bg-primary/10">
+          <Icon className="size-4.5 text-primary" />
+        </div>
+      </CardContent>
+    </Card>
+  );
+}
